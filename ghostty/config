# Ghostty 設定
# リファレンス: https://ghostty.org/docs/config/reference
# 設定リロード: Cmd+Shift+,

font-family = HackGen Console NF
font-size = 16

# ウィンドウ透過（1.0 で不透過、値を下げるほど透ける）
background-opacity = 0.85
# 背景のブラー（macOS のみ、半径を指定）
background-blur = 20

# macOS の Option を Alt として送る（herdr / nvim の Alt 系キー用）
macos-option-as-alt = true
# クリップボード読み取りの都度確認を無効化（nvim の OSC 52 連携用）
clipboard-read = allow
# herdr がセッションを永続化するため、閉じる際の確認は不要
confirm-close-surface = false
