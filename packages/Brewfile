# Homebrew で管理するもの。CLI ツールは原則 nix/home.nix 側で宣言する。
# ここに残すのは cask、nixpkgs に無いもの、brew 側に置く理由があるものだけ。
#
# VSCode 拡張機能（vscode "..." 行）は管理しない。brew bundle dump が
# code --list-extensions を自動で書き出すため、dump するたびに復活する。
# 再生成する場合は vscode 行を削除すること。
tap "osx-cross/arm"
tap "osx-cross/avr"
tap "qmk/qmk"
brew "webp"
brew "jpeg-xl"
brew "aom"
brew "libavif"
brew "gd"
brew "gdk-pixbuf"
brew "netpbm"
brew "librsvg"
brew "mingw-w64"
brew "mysql"
# QMK。formula 自身が avr-gcc@8 / arm-none-eabi-gcc@8 と各種書き込みツールを
# 依存として引き込む。nix に移すとこの依存束を自前で書き下すことになるため brew に置く。
brew "qmk/qmk/qmk"
cask "docker-desktop"
cask "font-hackgen-nerd"
cask "gcloud-cli"
cask "keycastr"
cask "ngrok"
cask "zed"
